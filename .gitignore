# ---------- ROS 2 / colcon 构建产物（最关键，务必保留这三条）----------
# 每次 colcon build 都会生成几十~几百 MB，绝对不能提交
build/
install/
log/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 大文件：rosbag / 点云 / 地图 ----------
# Git 存二进制大文件会让仓库永久膨胀且几乎无法瘦身，这类文件请走网盘
*.db3
*.mcap
*.bag
*.pcd
*.ply
*.bt
*.pbstream

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
