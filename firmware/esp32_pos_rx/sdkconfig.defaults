# pos_link ESP32-S3 receiver -- default config
#
# Target chip: ESP32-S3 (2.4 GHz WiFi only).
# sdkconfig is git-ignored and regenerated on first configure; this file only
# seeds that first configure, so the project never falls back to the ESP32
# default target (which builds a binary the S3 refuses to boot).
CONFIG_IDF_TARGET="esp32s3"
