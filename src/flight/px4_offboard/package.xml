<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_offboard</name>
  <version>3.1.0</version>
  <description>
    树莓派 ↔ PX4 的 MAVLink 桥：零依赖 MAVLink 编解码、ENU/FLU ↔ NED/FRD 坐标换算、
    以及把飞控状态整理成 /flight/status 的只读节点。
    不含任何 uXRCE-DDS 代码（那条路线在 v3.0.0 已因带宽问题放弃）。
  </description>

  <maintainer email="calxn29@qq.com">Cayssmet</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>uav_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
