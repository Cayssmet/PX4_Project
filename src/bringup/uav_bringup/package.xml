<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_bringup</name>
  <version>2.0.0</version>
  <description>
    2023 电赛 G 题《空地协同智能消防》的一体化启动包。
    只负责「把当前这一版真正存在的节点拉起来」，不做业务逻辑。
  </description>

  <maintainer email="ljz@example.com">ljz</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- 定位链 -->
  <exec_depend>lslidar_driver</exec_depend>
  <exec_depend>cartographer_config</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>map_coordinate_provider</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- 控制链 -->
  <exec_depend>position_pid_controller</exec_depend>

  <!-- 记录 -->
  <exec_depend>flight_data_recorder</exec_depend>

  <exec_depend>rviz2</exec_depend>

  <!-- 尚未接入 launch 的新包（等节点写好后取消注释）
  <exec_depend>px4_offboard</exec_depend>
  <exec_depend>k230_bridge</exec_depend>
  <exec_depend>competition_g</exec_depend>
  <exec_depend>car_link</exec_depend>
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
